# Supabase
SUPABASE_URL=your_supabase_url_here
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
# Backend only. Never expose this value through a NEXT_PUBLIC_* variable.
SUPABASE_SECRET_KEY=your_supabase_secret_key_here

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Resume files
RESUME_STORAGE_BUCKET=resumes
RESUME_MAX_FILE_SIZE_BYTES=6291456
RESUME_MAX_UNCOMPRESSED_SIZE_BYTES=52428800
RESUME_ALLOWED_EXTENSIONS=.pdf,.docx
RESUME_ALLOWED_MIME_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# App
APP_NAME=ResumeAI
DEBUG=true
CORS_ORIGINS=http://localhost:3000
